{# templates/frontend/docs/viewer.html.twig #}
{% extends '@Forumify/frontend/base.html.twig' %}

{% block title_page %}{{ page_title|default('Unit Documents') }}{% endblock %}

{% block body %}


<style>
/* Disable native bullets */
#docsMenu ul {
  list-style: none !important;
  margin: 0;
  padding-left: 0;
}

/* Controlled indentation per nesting level */
#docsMenu ul { padding-left: 18px; }
#docsMenu ul ul { padding-left: 22px; }
#docsMenu ul ul ul { padding-left: 26px; }

/* Each list item gets a fake bullet */
#docsMenu li {
  position: relative;
  padding-left: 14px;
  margin-top: 4px;
}

/* Bullet character */
#docsMenu li::before {
  content: "•";
  position: absolute;
  left: 0;
  top: 0.2em;
  line-height: 1;
}

/* Do not bullet <summary> text itself */
#docsMenu summary::before { content: ""; }
#docsMenu summary { cursor: pointer; }

/* Slight spacing between groups */
#docsMenu > details > ul > li { margin-top: 14px; }

/* Header buttons */
.doc-btn {
  padding: 6px 10px;
  border: 1px solid #888;
  border-radius: 4px;
  text-decoration: none;
  font-size: 0.9em;
  margin-left: 6px;
  background: transparent;
  color: inherit;
}

/* Make <button> match <a> styling */
.doc-btn[type="button"] { cursor: pointer; }
</style>

