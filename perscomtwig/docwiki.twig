{% set initial = items[0] %}

{# =========================
   HELPERS – COPY URL
   ========================= #}
{% macro file_id(url) %}
  {% set p = url|split('/d/') %}
  {% if p|length > 1 %}
    {{ p[1]|split('/')|first }}
  {% endif %}
{% endmacro %}
{% import _self as util %}

<div style="height:88vh; width:90%; margin:0 auto; display:flex; flex-direction:column;">

  <!-- HEADER -->
  <header>
    <table width="100%">
      <tr>
        <td>
          <h2 id="docTitle">{{ initial.title }}</h2>
        </td>
        <td align="right">
          <a id="copyBtn"
             class="copy-btn"
             href="#"
             target="_blank"
             style="display:none;">
            Make a copy
          </a>
        </td>
      </tr>
    </table>
  </header>

  <!-- BODY -->
  <div style="flex:1; min-height:0;">
    <table width="100%" height="100%" cellpadding="6" cellspacing="0">
      <tr>

        <!-- MENU -->
        <td valign="top" style="white-space:nowrap;">
          <div id="docsMenu">
            <details open>
              <summary>Documents</summary>
              <ul>

                {% for group in group_order %}
                  {% set has_group = false %}
                  {% for i in items %}{% if i.group == group %}{% set has_group = true %}{% endif %}{% endfor %}
                  {% if has_group %}
                    <li>
                      <details open>
                        <summary style="font-weight:bold; font-size:18pt;">{{ group }}</summary>
                        <ul>

                          {% for sg in subgroup_order[group] %}
                            {% set has_sg = false %}
                            {% for i in items %}{% if i.group == group and i.subgroup == sg %}{% set has_sg = true %}{% endif %}{% endfor %}
                            {% if has_sg %}
                              <li>
                                <details open>
                                  <summary>{{ sg }}</summary>
                                  <ul>
                                    {% for doc in items %}
                                      {% if doc.group == group and doc.subgroup == sg %}
                                        {% set fid = util.file_id(doc.url) %}
                                        {% if doc.type == 'slides' %}
                                          {% set copy_url = 'https://docs.google.com/presentation/d/' ~ fid ~ '/copy' %}
                                        {% else %}
                                          {% set copy_url = 'https://docs.google.com/document/d/' ~ fid ~ '/copy' %}
                                        {% endif %}
                                        <li>
                                          <a href="#"
                                             onclick="loadDoc('{{ doc.url }}','{{ doc.title|e('js') }}','{{ doc.copy is defined and doc.copy ? copy_url : '' }}'); return false;">
                                            {{ doc.title }}
                                          </a>
                                        </li>
                                      {% endif %}
                                    {% endfor %}
                                  </ul>
                                </details>
                              </li>
                            {% endif %}
                          {% endfor %}

                        </ul>
                      </details>
                    </li>
                  {% endif %}
                {% endfor %}

              </ul>
            </details>
          </div>
        </td>

        <!-- VIEWER -->
        <td valign="top" width="100%">
          <iframe id="viewer" src="{{ initial.url }}" width="100%" height="100%" frameborder="0"></iframe>
        </td>

      </tr>
    </table>
  </div>
</div>

<script>
function loadDoc(url, title, copyUrl) {
  document.getElementById('viewer').src = url;
  document.getElementById('docTitle').textContent = title;

  var btn = document.getElementById('copyBtn');
  if (copyUrl && copyUrl.length) {
    btn.href = copyUrl;
    btn.style.display = 'inline-block';
  } else {
    btn.style.display = 'none';
  }
}
</script>

{% endblock %}
