{# ======================================================================
   HELPERS
   ====================================================================== #}
{% macro google_file_id(url) %}
  {% set p = url|split('/d/') %}
  {% if p|length > 1 %}
    {{ p[1]|split('/')|first }}
  {% endif %}
{% endmacro %}

{% macro slugify(s) %}
  {% set x = s|lower %}
  {% set x = x|replace({'&':' and '}) %}
  {% set x = x|replace({'/':' ', '\\':' ', ':':' ', ';':' ', ',':' ', '.':' ', '(':' ', ')':' ', '[':' ', ']':' ', '{':' ', '}':' ', "'":'', '"':''}) %}
  {% set x = x|trim %}
  {% set x = x|replace({'  ':' '}) %}
  {% set x = x|replace({'  ':' '}) %}
  {% set x = x|replace({'  ':' '}) %}
  {% set x = x|replace({' ':'-'}) %}
  {{ x }}
{% endmacro %}

{% import _self as util %}

{# ======================================================================
   INITIAL DOC (supports deep link: ?doc=<key>)
   ====================================================================== #}
{% set selected_key = app.request.query.get('doc') %}
{% set initial = items[0] %}
{% set initial_key = initial.key is defined ? initial.key : util.slugify(initial.title) %}

{% if selected_key %}
  {% for d in items %}
    {% set d_key = d.key is defined ? d.key : util.slugify(d.title) %}
    {% if d_key == selected_key %}
      {% set initial = d %}
      {% set initial_key = d_key %}
    {% endif %}
  {% endfor %}
{% endif %}

{% set initial_type = initial.type|default('doc') %}
{% set initial_fid = util.google_file_id(initial.url) %}
{% set initial_copy_url = '' %}
{% if initial.copy is defined and initial.copy and initial_fid %}
  {% if initial_type == 'slides' %}
    {% set initial_copy_url = 'https://docs.google.com/presentation/d/' ~ initial_fid ~ '/copy' %}
  {% else %}
    {% set initial_copy_url = 'https://docs.google.com/document/d/' ~ initial_fid ~ '/copy' %}
  {% endif %}
{% endif %}

<div class="docs-shell">

  <!-- HEADER -->
  <header class="docs-header">
    <h2 id="docTitle" class="docs-title">{{ initial.title }}</h2>

    <div class="docs-actions">
      <a id="openBtn" class="doc-btn" href="{{ initial.url }}" target="_blank" rel="noopener">Open document</a>

      <a id="copyBtn" class="doc-btn" href="{{ initial_copy_url }}" target="_blank" rel="noopener"
         style="{{ initial_copy_url ? '' : 'display:none;' }}">Make a copy</a>

      <button id="copyLinkBtn" class="doc-btn" type="button">Copy link</button>
      <button id="bookmarkBtn" class="doc-btn" type="button">Bookmark</button>

      <button id="fsBtn" class="doc-btn mobile-only" type="button" aria-label="Fullscreen document">Full screen</button>
    </div>
  </header>

  <!-- BODY -->
  <div class="docs-body">

    <!-- MENU -->
    <aside class="docs-menu-col">
      <div id="docsMenu">
        <details open>
          <summary>Documents</summary>
          <ul>

            {% for group in group_order %}
              {% set has_group = false %}
              {% for i in items %}
                {% if i.group == group %}{% set has_group = true %}{% endif %}
              {% endfor %}

              {% if has_group %}
                <li>
                  <details open>
                    <summary class="docs-group-title">{{ group }}</summary>
                    <ul>

                      {% for sg in subgroup_order[group] %}
                        {% set has_sg = false %}
                        {% for i in items %}
                          {% if i.group == group and i.subgroup == sg %}{% set has_sg = true %}{% endif %}
                        {% endfor %}

                        {% if has_sg %}
                          <li>
                            <details open>
                              <summary>{{ sg }}</summary>
                              <ul>

                                {% for doc in items %}
                                  {% if doc.group == group and doc.subgroup == sg %}
                                    {% set doc_type = doc.type|default('doc') %}
                                    {% set fid = util.google_file_id(doc.url) %}
                                    {% set copy_url = '' %}

                                    {% if doc.copy is defined and doc.copy and fid %}
                                      {% if doc_type == 'slides' %}
                                        {% set copy_url = 'https://docs.google.com/presentation/d/' ~ fid ~ '/copy' %}
                                      {% else %}
                                        {% set copy_url = 'https://docs.google.com/document/d/' ~ fid ~ '/copy' %}
                                      {% endif %}
                                    {% endif %}

                                    {% set doc_key = doc.key is defined ? doc.key : util.slugify(doc.title) %}

                                    <li>
                                      <a href="#"
                                         onclick="loadDoc(
                                           '{{ doc.url }}',
                                           '{{ doc.title|e('js') }}',
                                           '{{ copy_url }}',
                                           '{{ doc_key|e('js') }}'
                                         ); return false;">
                                        {{ doc.title }}
                                      </a>
                                    </li>
                                  {% endif %}
                                {% endfor %}

                              </ul>
                            </details>
                          </li>
                        {% endif %}
                      {% endfor %}

                    </ul>
                  </details>
                </li>
              {% endif %}
            {% endfor %}

          </ul>
        </details>
      </div>
    </aside>

    <!-- VIEWER -->
    <main class="docs-viewer-col">

      {# Wrap iframe so we can resize the wrapper height on mobile #}
      <div id="viewerWrap" class="viewer-wrap">
        <iframe id="viewer" src="{{ initial.url }}" frameborder="0"></iframe>
      </div>

      {# Mobile drag handle to resize #}
      <div id="viewerResizeHandle" class="viewer-resize-handle" aria-label="Resize document">
        <div class="viewer-resize-grip"></div>
        <div class="viewer-resize-text">Drag to resize</div>
      </div>

    </main>

  </div>
</div>

<script>
let currentDocKey = '{{ initial_key|e('js') }}';

function loadDoc(url, title, copyUrl, docKey) {
  currentDocKey = docKey || currentDocKey || null;

  document.getElementById('viewer').src = url;
  document.getElementById('docTitle').textContent = title;

  const openBtn = document.getElementById('openBtn');
  openBtn.href = url;
  openBtn.style.display = 'inline-flex';

  const copyBtn = document.getElementById('copyBtn');
  if (copyUrl && copyUrl.length) {
    copyBtn.href = copyUrl;
    copyBtn.style.display = 'inline-flex';
  } else {
    copyBtn.style.display = 'none';
  }
}

function buildDeepLink(key) {
  const url = new URL(window.location.href);
  if (key) url.searchParams.set('doc', key);
  return url.toString();
}

async function copyToClipboard(text) {
  try {
    await navigator.clipboard.writeText(text);
    return true;
  } catch (e) {
    try {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('readonly', '');
      ta.style.position = 'absolute';
      ta.style.left = '-9999px';
      document.body.appendChild(ta);
      ta.select();
      const ok = document.execCommand('copy');
      document.body.removeChild(ta);
      return ok;
    } catch (e2) {
      return false;
    }
  }
}

document.getElementById('copyLinkBtn').addEventListener('click', async function() {
  if (!currentDocKey) { alert('Select a document first.'); return; }
  const link = buildDeepLink(currentDocKey);
  const ok = await copyToClipboard(link);
  alert(ok ? 'Link copied to clipboard.' : 'Failed to copy link.');
});

document.getElementById('bookmarkBtn').addEventListener('click', function() {
  if (!currentDocKey) { alert('Select a document first.'); return; }
  const url = new URL(window.location.href);
  url.searchParams.set('doc', currentDocKey);
  history.replaceState({}, '', url.toString());
  alert('Bookmarked (URL updated).');
});

/* =========================
   FULLSCREEN (mobile button)
   ========================= */
function isFullscreen() {
  return !!(document.fullscreenElement || document.webkitFullscreenElement);
}
async function requestFullscreen(el) {
  if (el.requestFullscreen) return el.requestFullscreen();
  if (el.webkitRequestFullscreen) return el.webkitRequestFullscreen();
}
async function exitFullscreen() {
  if (document.exitFullscreen) return document.exitFullscreen();
  if (document.webkitExitFullscreen) return document.webkitExitFullscreen();
}

const fsBtn = document.getElementById('fsBtn');
const viewer = document.getElementById('viewer');

if (fsBtn && viewer) {
  fsBtn.addEventListener('click', async function() {
    try {
      if (!isFullscreen()) await requestFullscreen(viewer);
      else await exitFullscreen();
    } catch (e) {
      window.open(viewer.src, '_blank', 'noopener');
    }
  });

  function syncFsButtonLabel() {
    fsBtn.textContent = isFullscreen() ? 'Exit full screen' : 'Full screen';
  }
  document.addEventListener('fullscreenchange', syncFsButtonLabel);
  document.addEventListener('webkitfullscreenchange', syncFsButtonLabel);
  syncFsButtonLabel();
}

/* =========================
   MOBILE RESIZE (touch drag handle)
   - resizes #viewerWrap height
   - saves in localStorage
   ========================= */
const viewerWrap = document.getElementById('viewerWrap');
const resizeHandle = document.getElementById('viewerResizeHandle');

function isMobileLayout() {
  return window.matchMedia && window.matchMedia('(max-width: 900px)').matches;
}

function clamp(n, min, max) { return Math.max(min, Math.min(max, n)); }

function applySavedViewerHeight() {
  if (!viewerWrap || !isMobileLayout()) return;

  const saved = parseInt(localStorage.getItem('docs_viewer_height_px') || '', 10);
  if (!isNaN(saved) && saved > 0) {
    const minH = Math.round(window.innerHeight * 0.45);
    const maxH = Math.round(window.innerHeight * 0.85);
    viewerWrap.style.height = clamp(saved, minH, maxH) + 'px';
  } else {
    // default = 8x11 based on width
    const defaultH = Math.round(viewerWrap.getBoundingClientRect().width * (11/8));
    const minH = Math.round(window.innerHeight * 0.45);
    const maxH = Math.round(window.innerHeight * 0.85);
    viewerWrap.style.height = clamp(defaultH, minH, maxH) + 'px';
  }
}

applySavedViewerHeight();
window.addEventListener('resize', applySavedViewerHeight);

if (viewerWrap && resizeHandle) {
  let startY = 0;
  let startH = 0;
  let dragging = false;

  function onStart(clientY) {
    if (!isMobileLayout()) return;
    dragging = true;
    startY = clientY;
    startH = viewerWrap.getBoundingClientRect().height;
    document.body.style.userSelect = 'none';
    document.body.style.webkitUserSelect = 'none';
  }

  function onMove(clientY) {
    if (!dragging) return;

    const dy = clientY - startY;
    const minH = Math.round(window.innerHeight * 0.45);
    const maxH = Math.round(window.innerHeight * 0.85);
    const newH = clamp(Math.round(startH + dy), minH, maxH);

    viewerWrap.style.height = newH + 'px';
    localStorage.setItem('docs_viewer_height_px', String(newH));
  }

  function onEnd() {
    dragging = false;
    document.body.style.userSelect = '';
    document.body.style.webkitUserSelect = '';
  }

  // Touch
  resizeHandle.addEventListener('touchstart', function(e){
    if (!e.touches || !e.touches.length) return;
    onStart(e.touches[0].clientY);
    e.preventDefault();
  }, { passive: false });

  resizeHandle.addEventListener('touchmove', function(e){
    if (!e.touches || !e.touches.length) return;
    onMove(e.touches[0].clientY);
    e.preventDefault();
  }, { passive: false });

  resizeHandle.addEventListener('touchend', function(){
    onEnd();
  });

  // Mouse (useful for dev tools mobile emulator)
  resizeHandle.addEventListener('mousedown', function(e){
    onStart(e.clientY);
    e.preventDefault();
  });
  window.addEventListener('mousemove', function(e){
    onMove(e.clientY);
  });
  window.addEventListener('mouseup', function(){
    onEnd();
  });
}
</script>

{% endblock %}
