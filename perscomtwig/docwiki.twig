{# templates/frontend/docs/viewer.html.twig #}
{% extends '@Forumify/frontend/base.html.twig' %}

{% block title_page %}{{ page_title|default('Unit Documents') }}{% endblock %}

{% block body %}

<style>
/* ===== bullets ===== */
#docsMenu ul { list-style: none !important; margin: 0; padding-left: 0; }
#docsMenu ul { padding-left: 18px; }
#docsMenu ul ul { padding-left: 22px; }
#docsMenu ul ul ul { padding-left: 26px; }
#docsMenu li { position: relative; padding-left: 14px; margin-top: 4px; }
#docsMenu li::before { content: "•"; position: absolute; left: 0; top: 0.2em; line-height: 1; }
#docsMenu summary::before { content: ""; }
#docsMenu summary { cursor: pointer; }
#docsMenu > details > ul > li { margin-top: 14px; }
#docsMenu a{ display:inline-block; padding:6px 0; text-decoration:none; }
#docsMenu a:hover{ text-decoration: underline; }

/* ===== buttons ===== */
.doc-btn{
  padding: 6px 10px;
  border: 1px solid #888;
  border-radius: 4px;
  text-decoration: none;
  font-size: 0.9em;
  margin-left: 6px;
  background: transparent;
  color: inherit;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  line-height: 1.1;
}
.doc-btn[type="button"]{ cursor:pointer; }

/* ===== layout (desktop) ===== */
.docs-shell{
  height: 88vh;
  width: 90%;
  margin: 0 auto;
  display:flex;
  flex-direction:column;
  min-height:0;
}
.docs-header{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:12px;
  flex-wrap:wrap;
}
.docs-title{ margin:0; line-height:1.2; }
.docs-actions{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:6px;
  flex-wrap:wrap;
}
.docs-body{
  flex:1;
  min-height:0;
  display:flex;
  gap:12px;
}
.docs-menu-col{
  width:340px;
  max-width:40%;
  overflow:auto;
  -webkit-overflow-scrolling:touch;
  padding-right:6px;
  white-space:normal;
}
.docs-group-title{ font-weight:bold; font-size:1.15rem; }

.docs-viewer-col{
  flex:1;
  min-width:0;
  min-height:0;
}

/* ===== viewer wrapper ===== */
.viewer-wrap{
  width: 100%;
  height: 100%;
  min-height: 0;
}
#viewer{
  width:100%;
  height:100%;
  border:0;
}

/* ===== mobile ===== */
.mobile-only{ display:none; }
.viewer-resize-handle{ display:none; }

@media (max-width: 900px){
  .mobile-only{ display:inline-flex; }

  .docs-shell{
    width: 100%;
    height: auto;
    min-height: calc(100vh - 110px);
    padding: 0 10px;
  }

  .docs-header{ flex-direction: column; align-items: stretch; }
  .docs-actions{ justify-content: flex-start; }
  .docs-body{ flex-direction: column; gap: 10px; }

  .docs-menu-col{
    width: 100%;
    max-width: 100%;
    padding-right: 0;
    max-height: 38vh;
    overflow: auto;
    border: 1px solid rgba(136,136,136,0.35);
    border-radius: 8px;
    padding: 8px;
  }

  /* On mobile: wrapper becomes “paper” by default but resizable via JS */
  .viewer-wrap{
    width: 100%;
    /* JS will set height; this is a sane default: 8x11 ratio */
    height: calc(100vw * 11 / 8);
    max-height: 85vh;
    min-height: 45vh;
    border: 1px solid rgba(136,136,136,0.35);
    border-radius: 8px;
    overflow: hidden;
    background: transparent;
  }

  #viewer{
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Touch drag bar */
  .viewer-resize-handle{
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
    -webkit-user-select: none;
    touch-action: none; /* we handle the drag */
    margin-top: 8px;
    padding: 10px 12px;
    border: 1px solid rgba(136,136,136,0.35);
    border-radius: 8px;
    cursor: ns-resize;
  }

  .viewer-resize-grip{
    width: 44px;
    height: 4px;
    border-radius: 999px;
    background: rgba(136,136,136,0.55);
  }

  .viewer-resize-text{
    margin-left: 10px;
    font-size: 0.9em;
    opacity: 0.85;
  }
}

@media (max-width: 520px){
  .docs-actions{ flex-direction:column; align-items:stretch; }
  .doc-btn{ width:100%; margin-left:0; }
}
</style>

